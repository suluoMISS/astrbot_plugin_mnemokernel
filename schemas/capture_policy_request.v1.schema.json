{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemokernel.local/schema/capture_policy_request.v1.json",
  "title": "MnemoKernel Capture Policy Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "scope", "action", "actor_id", "reason"],
  "properties": {
    "protocol": {"const": "mnemokernel.v1"},
    "scope": {"$ref": "raw_event.v1.schema.json#/$defs/scope"},
    "action": {"enum": ["pause", "resume"]},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
