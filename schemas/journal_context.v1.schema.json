{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemokernel.local/schema/journal_context.v1.json",
  "title": "MnemoKernel daily journal context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "scope_id", "journal_date", "context_truncated", "events"],
  "properties": {
    "status": {"enum": ["ok", "empty"]},
    "scope_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "journal_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "context_truncated": {"type": "boolean"},
    "events": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "occurred_at_ms", "origin_kind", "sender_display_name", "content", "content_truncated"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "occurred_at_ms": {"type": "integer", "minimum": 0},
          "origin_kind": {"enum": ["user_message", "bot_response"]},
          "sender_display_name": {"type": "string", "maxLength": 512},
          "content": {"type": "string", "maxLength": 2000},
          "content_truncated": {"type": "boolean"}
        }
      }
    }
  }
}
