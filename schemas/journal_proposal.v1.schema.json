{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemokernel.local/schema/journal_proposal.v1.json",
  "title": "MnemoKernel daily journal proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "proposal_id", "scope_id", "journal_date", "occurred_from_ms", "occurred_to_ms", "title", "summary", "cues", "open_loops", "claims"],
  "properties": {
    "protocol": {"const": "mnemokernel.v1"},
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "journal_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "occurred_from_ms": {"type": "integer", "minimum": 0},
    "occurred_to_ms": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 6000},
    "cues": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "open_loops": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "claims": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_kind", "claim_text", "epistemic_status", "evidence_event_ids"],
        "properties": {
          "claim_kind": {"enum": ["fact", "preference", "decision", "commitment", "relationship", "procedure", "open_loop"]},
          "claim_text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "epistemic_status": {"enum": ["assistant_inferred", "user_confirmed", "disputed"]},
          "evidence_event_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    }
  }
}
